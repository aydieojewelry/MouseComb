{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mousecomb.local/schemas/artifact-frontmatter.json",
  "title": "MouseComb artifact frontmatter",
  "description": "The YAML frontmatter at the top of a Markdown artifact. Which status may follow which is in status_transitions.json, not here.",
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "type": "string", "minLength": 1, "maxLength": 40 },
    "tags": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "created": { "type": "string", "format": "date" },
    "start": { "type": "string", "format": "date" },
    "end": { "type": "string", "format": "date" },
    "due": { "type": "string", "format": "date" },
    "published_at": { "type": "string", "format": "date-time" },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5 }
  },
  "dependentRequired": {
    "published_at": ["status"]
  },
  "if": {
    "properties": { "status": { "const": "published" } },
    "required": ["status"]
  },
  "then": {
    "required": ["title", "published_at"]
  },
  "additionalProperties": true
}
